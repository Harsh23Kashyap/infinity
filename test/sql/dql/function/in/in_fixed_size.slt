# name: test/sql/dql/function/in/in_fixed_size.slt
# description: IN must match fixed-size typed values (int, float, date, bool, etc.)
# group: [dql, function, in]
#
# Regression for a latent bug introduced by PR #9: Value::IsNull() returns
# (value_info_.get() == nullptr), but fixed-size types (Integer, BigInt, Float,
# Double, Boolean, TinyInt, SmallInt, HugeInt, Decimal, Date, Time, DateTime,
# Timestamp, Interval, RowID, Uuid) never allocate value_info_ (the value is
# stored inline in value_.T). So IsNull() is always true for fixed-size Values
# regardless of whether the value is actually NULL, and ValueSet::Exist()
# short-circuits to false. Effect: WHERE int_col IN (1,2,3) never matches.
#
# This SLT is the regression: it must pass both before AND after PR #9 lands,
# which means the fix to ValueSet::Exist must restore the fixed-size path
# while keeping the varlen NULL short-circuit from PR #9.

statement ok
DROP TABLE IF EXISTS test_in_fixed_size;

statement ok
CREATE TABLE test_in_fixed_size (
    i INTEGER,
    bi BIGINT,
    f FLOAT,
    d DOUBLE,
    b BOOLEAN,
    ts TIMESTAMP,
    dt DATE
);

statement ok
INSERT INTO test_in_fixed_size VALUES
(1,    100,    1.5,  10.5,  true,  '2024-01-01 00:00:00', '2024-01-01'),
(2,    200,    2.5,  20.5,  false, '2024-02-01 00:00:00', '2024-02-01'),
(3,    300,    3.5,  30.5,  true,  '2024-03-01 00:00:00', '2024-03-01'),
(NULL, 400,    4.5,  40.5,  false, '2024-04-01 00:00:00', '2024-04-01'),
(5,    NULL,   5.5,  50.5,  true,  NULL,                '2024-05-01'),
(6,    600,    NULL, 60.5,  false, '2024-06-01 00:00:00', NULL),
(7,    700,    7.5,  NULL,  true,  '2024-07-01 00:00:00', '2024-07-01');

# 1. Plain fixed-size IN must match. The pre-PR-9 behavior. The PR-9 +
# IsNull()-on-value_info_ regression would return zero rows.
query I rowsort
SELECT i FROM test_in_fixed_size WHERE i IN (1, 3, 5, 7);
----
1
3
5
7

# 2. BigInt IN.
query I rowsort
SELECT i FROM test_in_fixed_size WHERE bi IN (100, 300, 700);
----
1
3
7

# 3. Float IN.
query I rowsort
SELECT i FROM test_in_fixed_size WHERE f IN (1.5, 3.5, 7.5);
----
1
3
7

# 4. Double IN.
query I rowsort
SELECT i FROM test_in_fixed_size WHERE d IN (10.5, 30.5, 50.5);
----
1
3
5

# 5. Boolean IN.
query I rowsort
SELECT i FROM test_in_fixed_size WHERE b IN (true);
----
1
3
5
7

# 6. Date IN.
query I rowsort
SELECT i FROM test_in_fixed_size WHERE dt IN ('2024-01-01', '2024-03-01', '2024-05-01');
----
1
3
5

# 7. NULL semantics: a NULL value is UNKNOWN, so IN returns no match.
#    The row where i IS NULL must not appear in the IN result.
query I rowsort
SELECT i FROM test_in_fixed_size WHERE i IN (1, 3);
----
1
3

# 8. NOT IN: rows where the value is NULL are UNKNOWN for NOT IN, so per
#    SQL semantics they do not match (i.e. NOT IN must NOT return the NULL
#    row, but it also must NOT return the matching rows). Rows where the
#    value is non-NULL and not in the list DO match.
query I rowsort
SELECT i FROM test_in_fixed_size WHERE i NOT IN (1, 3, 5, 7);
----
2
6

# 9. NOT IN must not regress the existing baseline: rows 2 and 6 (i=2 and
#    i=6) are non-NULL and not in the list, so they must appear.
query I rowsort
SELECT i FROM test_in_fixed_size WHERE i NOT IN (1, 3, 5, 7, 100, 200, 300);
----
2
6

# 10. Mixed types: a row where the typed value is non-NULL but the column
#     has a NULL marker elsewhere must still match when the value is in
#     the list.
query I rowsort
SELECT i FROM test_in_fixed_size WHERE f IS NOT NULL AND f IN (1.5, 2.5, 7.5);
----
1
2
7

statement ok
DROP TABLE test_in_fixed_size;
